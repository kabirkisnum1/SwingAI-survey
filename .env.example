# Optional — server uses port 3000 by default
PORT=3000

# Supabase persistence (set both on Render for production)
# Without these, responses are stored in data/responses.jsonl (local dev only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Survey video catalog (run npm run build-catalog after updating BC Ghost outputs)
# GOLFDB_REPO_ROOT=/path/to/golfdb-master
# SURVEY_CATALOG_PATH=./data/survey_catalog.json
