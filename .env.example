# Optional — server uses port 3000 by default
PORT=3000

# Supabase persistence (set both on Render for production)
# Without these, responses are stored in data/responses.jsonl (local dev only)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Survey videos (self-contained after bundling):
#   npm run build-catalog && npm run bundle-media
# Copies all clips to data/media/ (~12 GB). No GOLFDB_REPO_ROOT needed after bundle.
# SURVEY_CATALOG_PATH=./data/survey_catalog.json
